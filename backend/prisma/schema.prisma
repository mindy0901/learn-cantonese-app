generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model HanziRadical {
    id          String   @id @default(uuid()) @db.Uuid
    number      Int      @unique @map("number")
    char        String   @map("char") @db.VarChar
    name        String   @map("name") @db.VarChar
    desc        String?  @map("desc") @db.Text
    pinyin      String?  @map("pinyin") @db.VarChar
    variants    String[] @map("variants") @db.VarChar
    strokeCount Int      @map("stroke_count")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("radicals")
}

model MandarinVocabulary {
    id               String  @id @default(uuid()) @db.Uuid
    hanziSimplified  String? @default("") @map("hanzi_simplified") @db.VarChar
    hanziTraditional String? @default("") @map("hanzi_traditional") @db.VarChar
    hanziCharacters  Json?   @map("hanzi_characters") @db.JsonB
    hskLevel         String? @default("") @map("hsk_level") @db.VarChar
    popularity       Float?  @db.Real
    // ⚠️ 2026-09-05: level 1–5 (1=Hiếm … 5=Rất cao) — backfill từ popularity qua quintile
    popularityLevel  Int?    @map("popularity_level")
    // ⚠️ 2026-08-22: từ ghép / đồng nghĩa / trái nghĩa từ Hanzii — JSONB
    // { compound: string[], synonyms: string[], antonyms: string[] }
    relatedWords     Json?   @map("related_words") @db.JsonB

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    romanizations                     MandarinVocabularyRomanization[]
    flashcardDeckMandarinVocabularies FlashcardDeckMandarinVocabulary[]
    vocabularySetMandarinVocabularies VocabularySetMandarinVocabulary[]

    @@index([hskLevel])
    @@index([hanziSimplified])
    @@index([hanziTraditional])
    @@map("mandarin_vocabularies")
}

model MandarinVocabularyRomanization {
    id                   String @id @default(uuid()) @db.Uuid
    mandarinVocabularyId String @map("mandarin_vocabulary_id") @db.Uuid
    pinyin               String @map("pinyin") @db.VarChar
    sinoVietnamese       String @map("sino_vietnamese") @db.VarChar

    mandarinVocabulary MandarinVocabulary          @relation(fields: [mandarinVocabularyId], references: [id], onDelete: Cascade)
    meanings           MandarinVocabularyMeaning[]

    @@index([mandarinVocabularyId])
    @@map("mandarin_vocabulary_romanizations")
}

model MandarinVocabularyMeaning {
    id                               String @id @default(uuid()) @db.Uuid
    mandarinVocabularyRomanizationId String @map("mandarin_vocabulary_romanization_id") @db.Uuid
    zh                               String @default("") @map("zh") @db.VarChar
    vi                               String @default("") @map("vi") @db.Text
    en                               String @default("") @map("en") @db.Text
    // ⚠️ 2026-09-20: thứ tự hiển thị meaning trong 1 reading (0-based) — user đổi được ở UI edit.
    position                         Int    @default(0) @db.SmallInt

    mandarinVocabularyRomanization MandarinVocabularyRomanization @relation(fields: [mandarinVocabularyRomanizationId], references: [id], onDelete: Cascade)
    examples                       MandarinVocabularyExample[]

    @@index([mandarinVocabularyRomanizationId])
    @@map("mandarin_vocabulary_meanings")
}

model MandarinVocabularyExample {
    id                          String @id @default(uuid()) @db.Uuid
    mandarinVocabularyMeaningId String @map("mandarin_vocabulary_meaning_id") @db.Uuid
    zh                          String @default("") @map("zh") @db.VarChar
    romanization                String @default("") @map("romanization") @db.VarChar
    vi                          String @default("") @map("vi") @db.Text
    en                          String @default("") @map("en") @db.Text

    mandarinVocabularyMeaning MandarinVocabularyMeaning @relation(fields: [mandarinVocabularyMeaningId], references: [id], onDelete: Cascade)

    @@index([mandarinVocabularyMeaningId])
    @@map("mandarin_vocabulary_examples")
}

model CantoneseVocabulary {
    id                 String  @id @default(uuid()) @db.Uuid
    hanziTraditionalHk String? @default("") @map("hanzi_traditional_hk") @db.VarChar
    pureCantonese      Boolean @default(false) @map("pure_cantonese")
    popularity         Float?  @db.Real
    // ⚠️ 2026-09-05: level 1–5 (1=Hiếm … 5=Rất cao) — backfill từ popularity qua quintile
    popularityLevel    Int?    @map("popularity_level")
    hanziCharacters    Json?   @map("hanzi_characters") @db.JsonB
    // ⚠️ 2026-08-22: từ ghép / đồng nghĩa / trái nghĩa từ Hanzii (giống mandarin)
    // { compound: string[], synonyms: string[], antonyms: string[] } (theo pinyin map)
    relatedWords       Json?   @map("related_words") @db.JsonB
    // ⚠️ 2026-08-22: audio CC101 (R2 public URL) — hanzi + english meaning
    hanziAudio         String? @map("hanzi_audio") @db.VarChar
    englishAudio       String? @map("english_audio") @db.VarChar

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    romanizations                      CantoneseVocabularyRomanization[]
    flashcardDeckCantoneseVocabularies FlashcardDeckCantoneseVocabulary[]
    vocabularySetCantoneseVocabularies VocabularySetCantoneseVocabulary[]

    @@index([hanziTraditionalHk])
    @@index([pureCantonese])
    @@map("cantonese_vocabularies")
}

model CantoneseVocabularyRomanization {
    id                    String @id @default(uuid()) @db.Uuid
    cantoneseVocabularyId String @map("cantonese_vocabulary_id") @db.Uuid
    jyutping              String @map("jyutping") @db.VarChar
    sinoVietnamese        String @map("sino_vietnamese") @db.VarChar

    cantoneseVocabulary CantoneseVocabulary          @relation(fields: [cantoneseVocabularyId], references: [id], onDelete: Cascade)
    meanings            CantoneseVocabularyMeaning[]

    @@index([cantoneseVocabularyId])
    @@map("cantonese_vocabulary_romanizations")
}

model CantoneseVocabularyMeaning {
    id                                String @id @default(uuid()) @db.Uuid
    cantoneseVocabularyRomanizationId String @map("cantonese_vocabulary_romanization_id") @db.Uuid
    vi                                String @default("") @map("vi") @db.Text
    en                                String @default("") @map("en") @db.Text
    // ⚠️ 2026-09-20: thứ tự hiển thị meaning trong 1 reading (0-based) — user đổi được ở UI edit.
    position                          Int    @default(0) @db.SmallInt

    cantoneseVocabularyRomanization CantoneseVocabularyRomanization @relation(fields: [cantoneseVocabularyRomanizationId], references: [id], onDelete: Cascade)
    examples                        CantoneseVocabularyExample[]

    @@index([cantoneseVocabularyRomanizationId])
    @@map("cantonese_vocabulary_meanings")
}

model CantoneseVocabularyExample {
    id                           String  @id @default(uuid()) @db.Uuid
    cantoneseVocabularyMeaningId String  @map("cantonese_vocabulary_meaning_id") @db.Uuid
    yue                          String  @default("") @map("yue") @db.VarChar
    romanization                 String  @default("") @map("romanization") @db.VarChar
    vi                           String  @default("") @map("vi") @db.Text
    en                           String  @default("") @map("en") @db.Text
    // ⚠️ 2026-08-22: audio CC101 (R2 public URL) — hanzi + english example
    hanziAudio                   String? @map("hanzi_audio") @db.VarChar
    englishAudio                 String? @map("english_audio") @db.VarChar

    cantoneseVocabularyMeaning CantoneseVocabularyMeaning @relation(fields: [cantoneseVocabularyMeaningId], references: [id], onDelete: Cascade)

    @@index([cantoneseVocabularyMeaningId])
    @@map("cantonese_vocabulary_examples")
}

model Grammar {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    title     String   @default("") @db.VarChar
    content   String   @default("") @db.Text
    details   String[] @default([]) @db.VarChar
    notes     String[] @default([]) @db.VarChar
    structure String?  @default("") @db.Text
    hskLevel  String?  @default("") @map("hsk_level") @db.VarChar
    important Boolean  @default(false)
    mastered  Boolean  @default(false)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    grammarExamples GrammarExample[]

    @@unique([id, userId])
    @@index([userId])
    @@map("grammars")
}

model GrammarExample {
    id              String  @id @default(uuid()) @db.Uuid
    grammarId       String  @map("grammar_id") @db.Uuid
    hanExample      String? @default("") @map("han_example") @db.Text
    jyutpingExample String? @default("") @map("jyutping_example") @db.VarChar
    pinyinExample   String? @default("") @map("pinyin_example") @db.VarChar
    vietExample     String? @default("") @map("viet_example") @db.VarChar
    engExample      String? @default("") @map("eng_example") @db.VarChar
    position        Int     @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

    @@map("grammar_examples")
}

model User {
    id                   String                   @id @default(uuid()) @db.Uuid
    email                String                   @unique
    password             String?                  @db.VarChar
    name                 String?
    isAdmin              Boolean                  @default(false) @map("is_admin")
    createdAt            DateTime                 @default(now()) @map("created_at")
    updatedAt            DateTime                 @updatedAt @map("updated_at")
    flashcardDecks       FlashcardDeck[]
    vocabularySets       VocabularySet[]
    checkins             UserCheckin[]
    favoriteVocabularies UserFavoriteVocabulary[]
    dislikedVocabularies UserDislikedVocabulary[]
    vocabularyMastery    UserVocabularyMastery[]

    @@map("users")
}

// ⚠️ 2026-09-20: cặp đánh dấu theo user (thay "important" từ 2026-09-02):
//   ❤️ `UserFavoriteVocabulary` = "yêu thích"   · 🚫 `UserDislikedVocabulary` = "không muốn học"
// 2 trạng thái LOẠI TRỪ NHAU. Từ `disliked` KHÔNG xuất hiện trong flashcard random.
// `language` = 'mandarin' | 'cantonese'; `vocabularyId` = id từ tương ứng (uuid, unique toàn cục).
model UserFavoriteVocabulary {
    id           String   @id @default(uuid()) @db.Uuid
    userId       String   @map("user_id") @db.Uuid
    language     String   @map("language") @db.VarChar
    vocabularyId String   @map("vocabulary_id") @db.Uuid
    createdAt    DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, language, vocabularyId])
    @@index([userId])
    @@map("user_favorite_vocabularies")
}

model UserDislikedVocabulary {
    id           String   @id @default(uuid()) @db.Uuid
    userId       String   @map("user_id") @db.Uuid
    language     String   @map("language") @db.VarChar
    vocabularyId String   @map("vocabulary_id") @db.Uuid
    createdAt    DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, language, vocabularyId])
    @@index([userId])
    @@map("user_disliked_vocabularies")
}

model UserCheckin {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    date      DateTime @map("checkin_date") @db.Date
    createdAt DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, date])
    @@index([userId])
    @@map("user_checkins")
}

// ⚠️ 2026-09-02: tiến độ "mastered" theo từ (progress 0-100%) cho mọi user đã đăng nhập.
// Khó +5 / Trung bình +10 / Dễ +25; Lại nữa → reset 0; Đã nắm → 100 (mastered).
// `language` = 'mandarin' | 'cantonese'; `vocabularyId` = id từ tương ứng (uuid, unique toàn cục).
model UserVocabularyMastery {
    id           String   @id @default(uuid()) @db.Uuid
    userId       String   @map("user_id") @db.Uuid
    language     String   @map("language") @db.VarChar
    vocabularyId String   @map("vocabulary_id") @db.Uuid
    progress     Int      @default(0) @map("progress")
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, language, vocabularyId])
    @@index([userId])
    @@map("user_vocabulary_mastery")
}

// ⚠️ 2026-09-27: TAG dùng chung toàn app (CHỈ admin tạo/đổi tên/xóa + gán cho từ vựng).
// `VocabularyTag` = liên kết tag ↔ từ vựng đã có (theo ngôn ngữ; KHÔNG FK tới 2 bảng vocab
// riêng biệt — chỉ FK tới `tags`, xóa tag → cascade gỡ liên kết).
model Tag {
    id             String          @id @default(uuid()) @db.Uuid
    name           String          @unique @db.VarChar(64)
    // ⚠️ 2026-09-27: màu tag do ADMIN chọn từ palette (bỏ màu random theo hash).
    color          String?         @db.VarChar(16)
    createdAt      DateTime        @default(now()) @map("created_at")
    vocabularyTags VocabularyTag[]

    @@map("tags")
}

model VocabularyTag {
    id           String   @id @default(uuid()) @db.Uuid
    tagId        String   @map("tag_id") @db.Uuid
    language     String   @map("language") @db.VarChar
    vocabularyId String   @map("vocabulary_id") @db.Uuid
    createdAt    DateTime @default(now()) @map("created_at")

    tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@unique([tagId, language, vocabularyId])
    @@index([tagId])
    @@map("vocabulary_tags")
}

model FlashcardDeck {
    id          String  @id @default(uuid()) @db.Uuid
    userId      String  @map("user_id") @db.Uuid
    name        String  @default("") @db.VarChar
    description String? @default("") @db.Text
    color       String? @default("") @db.VarChar

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user                  User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
    mandarinVocabularies  FlashcardDeckMandarinVocabulary[]
    cantoneseVocabularies FlashcardDeckCantoneseVocabulary[]

    @@unique([id, userId])
    @@index([userId])
    @@map("flashcard_decks")
}

model FlashcardDeckMandarinVocabulary {
    id                   String @id @default(uuid()) @db.Uuid
    deckId               String @map("deck_id") @db.Uuid
    mandarinVocabularyId String @map("mandarin_vocabulary_id") @db.Uuid
    position             Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    deck               FlashcardDeck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
    mandarinVocabulary MandarinVocabulary @relation(fields: [mandarinVocabularyId], references: [id], onDelete: Cascade)

    @@unique([deckId, mandarinVocabularyId])
    @@index([mandarinVocabularyId])
    @@map("flashcard_deck_mandarin_vocabularies")
}

model FlashcardDeckCantoneseVocabulary {
    id                    String @id @default(uuid()) @db.Uuid
    deckId                String @map("deck_id") @db.Uuid
    cantoneseVocabularyId String @map("cantonese_vocabulary_id") @db.Uuid
    position              Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    deck                FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
    cantoneseVocabulary CantoneseVocabulary @relation(fields: [cantoneseVocabularyId], references: [id], onDelete: Cascade)

    @@unique([deckId, cantoneseVocabularyId])
    @@index([cantoneseVocabularyId])
    @@map("flashcard_deck_cantonese_vocabularies")
}

model VocabularySet {
    id          String  @id @default(uuid()) @db.Uuid
    userId      String  @map("user_id") @db.Uuid
    name        String  @default("") @db.VarChar
    description String? @default("") @db.Text
    color       String? @default("") @db.VarChar

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user                  User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
    mandarinVocabularies  VocabularySetMandarinVocabulary[]
    cantoneseVocabularies VocabularySetCantoneseVocabulary[]

    @@unique([id, userId])
    @@index([userId])
    @@map("vocabulary_sets")
}

model VocabularySetMandarinVocabulary {
    id                   String @id @default(uuid()) @db.Uuid
    setId                String @map("set_id") @db.Uuid
    mandarinVocabularyId String @map("mandarin_vocabulary_id") @db.Uuid
    position             Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    set                VocabularySet      @relation(fields: [setId], references: [id], onDelete: Cascade)
    mandarinVocabulary MandarinVocabulary @relation(fields: [mandarinVocabularyId], references: [id], onDelete: Cascade)

    @@unique([setId, mandarinVocabularyId])
    @@index([mandarinVocabularyId])
    @@map("vocabulary_set_mandarin_vocabularies")
}

model VocabularySetCantoneseVocabulary {
    id                    String @id @default(uuid()) @db.Uuid
    setId                 String @map("set_id") @db.Uuid
    cantoneseVocabularyId String @map("cantonese_vocabulary_id") @db.Uuid
    position              Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    set                 VocabularySet       @relation(fields: [setId], references: [id], onDelete: Cascade)
    cantoneseVocabulary CantoneseVocabulary @relation(fields: [cantoneseVocabularyId], references: [id], onDelete: Cascade)

    @@unique([setId, cantoneseVocabularyId])
    @@index([cantoneseVocabularyId])
    @@map("vocabulary_set_cantonese_vocabularies")
}
