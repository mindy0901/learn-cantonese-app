// Starter models — replace with your own

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model HanCharacter {
    id             String   @id @default(uuid()) @db.Uuid
    sinoVietnamese String[] @map("sino_vietnamese") @db.VarChar
    hanSimplified  String?  @default("") @map("han_simplified") @db.VarChar
    pinyin         String[] @db.VarChar
    hanTraditional String   @map("han_traditional") @db.VarChar
    jyutping       String[] @db.VarChar
    hskLevel       String?  @default("") @map("hsk_level") @db.VarChar
    searchKey      String?  @map("search_key") @db.Text
    frequency      Int?     @map("frequency")
    strokeCount    Int?     @map("stroke_count")
    radicalId      String?  @map("radical_id") @db.Uuid

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    radical              Radical?              @relation(fields: [radicalId], references: [id], onDelete: SetNull)
    vocabularyCharacters VocabularyCharacter[]

    @@unique([id, hanSimplified, hanTraditional])
    @@index([jyutping, pinyin])
    @@index([radicalId])
    @@map("han_characters")
}

model Radical {
    id          String   @id @default(uuid()) @db.Uuid
    number      Int      @unique @map("number")
    char        String   @map("char") @db.VarChar
    name        String   @map("name") @db.VarChar
    desc        String?  @map("desc") @db.Text
    pinyin      String?  @map("pinyin") @db.VarChar
    variants    String[] @map("variants") @db.VarChar
    strokeCount Int      @map("stroke_count")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    hanCharacters HanCharacter[]

    @@map("radicals")
}

model Vocabulary {
    id             String   @id @default(uuid()) @db.Uuid
    hanSimplified  String?  @default("") @map("han_simplified") @db.VarChar
    hanTraditional String   @default("") @map("han_traditional") @db.VarChar
    hanHongKong    String?  @default("") @map("han_hongkong") @db.VarChar
    hskLevel       String?  @default("") @map("hsk_level") @db.VarChar
    pureCantonese  Boolean? @default(false) @map("pure_cantonese")
    searchKey      String?  @map("search_key") @db.Text
    partOfSpeech   String?  @default("") @map("part_of_speech") @db.VarChar
    frequency      Int?     @map("frequency")
    radical        String?  @default("") @db.VarChar
    classifiers    String?  @default("") @db.VarChar
    movieWordRank  Int?     @map("movie_word_rank")
    bookWordRank   Int?     @map("book_word_rank")
    relatedWords   Json?    @map("related_words") @db.JsonB
    hanCharacters  Json?    @map("han_characters") @db.JsonB
    boost          Float?   @db.Real

    romanizationJson Json? @map("romanization_json") @db.JsonB

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    vocabularyCharacters      VocabularyCharacter[]
    userVocabularies          UserVocabulary[]
    flashcardDeckVocabularies FlashcardDeckVocabulary[]
    vocabularySetVocabularies VocabularySetVocabulary[]

    @@index([searchKey, hskLevel])
    @@map("vocabularies")
}

model VocabularyCharacter {
    id             String       @id @default(uuid()) @db.Uuid
    vocabularyId   String       @map("vocabulary_id") @db.Uuid
    hanCharacterId String       @map("han_character_id") @db.Uuid
    position       Int          @db.SmallInt
    vocabulary     Vocabulary   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
    hanCharacter   HanCharacter @relation(fields: [hanCharacterId], references: [id], onDelete: Cascade)

    @@unique([vocabularyId, hanCharacterId])
    @@unique([vocabularyId, position])
    @@index([hanCharacterId])
    @@map("vocabulary_characters")
}

model Grammar {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    title     String   @default("") @db.VarChar
    content   String   @default("") @db.Text
    details   String[] @default([]) @db.VarChar
    notes     String[] @default([]) @db.VarChar
    structure String?  @default("") @db.Text
    hskLevel  String?  @default("") @map("hsk_level") @db.VarChar
    important Boolean  @default(false)
    mastered  Boolean  @default(false)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    grammarExamples GrammarExample[]

    @@unique([id, userId])
    @@index([userId])
    @@map("grammars")
}

model GrammarExample {
    id              String  @id @default(uuid()) @db.Uuid
    grammarId       String  @map("grammar_id") @db.Uuid
    hanExample      String? @default("") @map("han_example") @db.Text
    jyutpingExample String? @default("") @map("jyutping_example") @db.VarChar
    pinyinExample   String? @default("") @map("pinyin_example") @db.VarChar
    vietExample     String? @default("") @map("viet_example") @db.VarChar
    engExample      String? @default("") @map("eng_example") @db.VarChar
    position        Int     @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    grammar Grammar @relation(fields: [grammarId], references: [id], onDelete: Cascade)

    @@map("grammar_examples")
}

model User {
    id               String           @id @default(uuid()) @db.Uuid
    email            String           @unique
    password         String?          @db.VarChar
    name             String?
    isAdmin          Boolean          @default(false) @map("is_admin")
    createdAt        DateTime         @default(now()) @map("created_at")
    updatedAt        DateTime         @updatedAt @map("updated_at")
    userVocabularies UserVocabulary[]
    flashcardDecks   FlashcardDeck[]
    vocabularySets   VocabularySet[]

    @@map("users")
}

model UserVocabulary {
    id              String     @id @default(uuid()) @db.Uuid
    userId          String     @map("user_id") @db.Uuid
    vocabularyId    String     @map("vocabulary_id") @db.Uuid
    user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    vocabulary      Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
    important       Boolean    @default(false)
    mastered        Boolean    @default(false)
    studyProgress   Int        @default(0) @map("study_progress") @db.SmallInt
    studyProgressAt DateTime?  @map("study_progress_at")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([userId, vocabularyId])
    @@index([userId])
    @@index([vocabularyId])
    @@map("user_vocabularies")
}

model SentencePattern {
    id             String   @id @default(uuid()) @db.Uuid
    userId         String   @map("user_id") @db.Uuid
    hanTraditional String   @default("") @map("han_traditional") @db.VarChar
    hanSimplified  String?  @map("han_simplified") @db.VarChar
    jyutping       String?  @db.VarChar
    pinyin         String?  @db.VarChar
    vietnamese     String   @default("") @db.VarChar
    english        String   @default("") @db.VarChar
    wordIds        String[] @map("word_ids") @db.Uuid
    important      Boolean  @default(false)
    mastered       Boolean  @default(false)
    createdAt      DateTime @default(now()) @map("created_at")
    updatedAt      DateTime @updatedAt @map("updated_at")

    @@unique([id, userId])
    @@index([userId])
    @@map("sentence_patterns")
}

model FlashcardDeck {
    id          String  @id @default(uuid()) @db.Uuid
    userId      String  @map("user_id") @db.Uuid
    name        String  @default("") @db.VarChar
    description String? @default("") @db.Text
    color       String? @default("") @db.VarChar

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
    vocabularies FlashcardDeckVocabulary[]

    @@unique([id, userId])
    @@index([userId])
    @@map("flashcard_decks")
}

model FlashcardDeckVocabulary {
    id           String @id @default(uuid()) @db.Uuid
    deckId       String @map("deck_id") @db.Uuid
    vocabularyId String @map("vocabulary_id") @db.Uuid
    position     Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
    vocabulary Vocabulary    @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

    @@unique([deckId, vocabularyId])
    @@index([vocabularyId])
    @@map("flashcard_deck_vocabularies")
}

model VocabularySet {
    id          String  @id @default(uuid()) @db.Uuid
    userId      String  @map("user_id") @db.Uuid
    name        String  @default("") @db.VarChar
    description String? @default("") @db.Text
    color       String? @default("") @db.VarChar

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
    vocabularies VocabularySetVocabulary[]

    @@unique([id, userId])
    @@index([userId])
    @@map("vocabulary_sets")
}

model VocabularySetVocabulary {
    id           String @id @default(uuid()) @db.Uuid
    setId        String @map("set_id") @db.Uuid
    vocabularyId String @map("vocabulary_id") @db.Uuid
    position     Int    @default(0) @db.SmallInt

    createdAt DateTime @default(now()) @map("created_at")

    set        VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)
    vocabulary Vocabulary    @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

    @@unique([setId, vocabularyId])
    @@index([vocabularyId])
    @@map("vocabulary_set_vocabularies")
}
